<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Federica Grassi | Portfolio</title>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;0,6..96,900;1,6..96,400;1,6..96,700;1,6..96,900&family=Raleway:wght@100;200;300;400;500&family=Cinzel:wght@400;600;900&display=swap" rel="stylesheet">
<style>
:root {
  --void: #050403; --deep: #0C0906; --ember: #C8783A; --ember-pale: #E4A96A;
  --champagne: #F0E2C8; --champagne-dim: #C9B898; --ivory: #FAF6EE;
  --gold-line: rgba(200,120,58,.25);
}

*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
html { scroll-behavior:smooth; }
body {
  background:var(--void); color:var(--champagne);
  font-family:'Raleway',sans-serif; font-weight:300;
  overflow-x:hidden; cursor:none; font-size: 18px; /* Improved PC readability */
}

/* CURSOR */
#cur { position:fixed; width:5px; height:5px; background:var(--ember); border-radius:50%; pointer-events:none; transform:translate(-50%,-50%); z-index:9999; }
#cur-r { position:fixed; width:24px; height:24px; border:1px solid var(--ember); border-radius:50%; pointer-events:none; transform:translate(-50%,-50%); z-index:9998; opacity:.5; transition:all .3s ease; }

/* NAV */
nav {
  position:fixed; top:0; left:0; right:0; z-index:500;
  padding:30px 72px; display:flex; justify-content:space-between; align-items:center;
  transition:all .5s;
}
nav.scrolled { background:rgba(5,4,3,.93); backdrop-filter:blur(24px); padding:18px 72px; border-bottom:1px solid var(--gold-line); }
.nav-logo { font-family:'Cinzel',serif; font-size:18px; letter-spacing:6px; text-transform:uppercase; color:var(--ember); text-decoration:none; }
.nav-links { display:flex; gap:44px; list-style:none; }
.nav-links a { font-size:14px; font-weight:400; letter-spacing:3px; text-transform:uppercase; color:var(--champagne-dim); text-decoration:none; transition:color .3s; }

/* HERO */
#hero {
  min-height:100vh; display:flex; align-items:center; padding:0 72px;
  position:relative; overflow:hidden; background: var(--void);
}
.hero-name { font-family:'Bodoni Moda',serif; font-size:115px; font-weight:900; line-height:.87; margin-bottom:12px; }
.hero-name em { font-style:italic; color:var(--ember); }
.hero-subtitle { font-family:'Bodoni Moda',serif; font-style:italic; font-size:26px; color:var(--champagne-dim); margin-bottom:36px; }
.hero-bio { font-size:18px; line-height:1.8; color:rgba(200,174,152,.8); max-width:500px; margin-bottom:52px; }

/* BUTTONS */
.btn-ember { display:inline-block; padding:18px 45px; background:linear-gradient(135deg, var(--ember), var(--ember-pale)); color:var(--void); font-family:'Cinzel',serif; font-size:14px; letter-spacing:3px; text-transform:uppercase; text-decoration:none; font-weight:600; }

/* CONTACT SECTION - PHONE REMOVED */
#contact { padding:130px 72px; text-align:center; background:var(--void); }
.contact-title { font-family:'Bodoni Moda',serif; font-size:100px; font-weight:900; margin-bottom:52px; }
.contact-links { display:flex; justify-content:center; gap:48px; }
.c-link { font-family:'Cinzel',serif; font-size:16px; letter-spacing:4px; text-transform:uppercase; color:var(--champagne-dim); text-decoration:none; }
.footer-bar { margin-top:110px; padding-top:40px; border-top:1px solid rgba(255,255,255,.04); display:flex; justify-content:space-between; align-items:center; }
.footer-bar span { font-size:13px; color:rgba(255,255,255,.2); }

@media(max-width:900px){
  .hero-name { font-size: 60px; }
  .contact-title { font-size: 50px; }
  .nav-links { display:none; }
}
</style>
</head>
<body>
<div id="cur"></div>
<div id="cur-r"></div>

<nav id="nav">
  <a href="#" class="nav-logo">Federica Grassi</a>
  <ul class="nav-links">
    <li><a href="#about">About</a></li>
    <li><a href="#experience">Experience</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
</nav>

<section id="hero">
  <div class="hero-inner">
    <div class="hero-text">
        <div style="font-family:'Cinzel',serif; color:var(--ember); letter-spacing:6px; margin-bottom:20px;">Portfolio 2025</div>
        <h1 class="hero-name">Federica <em>Grassi</em></h1>
        <p class="hero-subtitle">Luxury Brand Strategist</p>
        <p class="hero-bio">Specializing in brand management and luxury marketing in the Milan fashion landscape.</p>
        <div class="hero-ctas">
            <a href="#contact" class="btn-ember">Get in Touch</a>
        </div>
    </div>
  </div>
</section>

<section id="contact">
  <h2 class="contact-title">Let's <em>Connect</em></h2>
  <div class="contact-links">
    <a href="mailto:federicagrassi@example.com" class="c-link">Email</a>
    <a href="https://linkedin.com" target="_blank" class="c-link">LinkedIn</a>
  </div>
  <div class="footer-bar">
    <span>Federica Grassi — 2025</span>
    <span style="font-family:'Bodoni Moda'; color:rgba(200,120,58,.2); font-size:30px;">FG</span>
    <span>Milan, Italy</span>
  </div>
</section>

<script>
const cur=document.getElementById('cur'),ring=document.getElementById('cur-r');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cur.style.left=mx+'px';cur.style.top=my+'px';});
(function loop(){rx+=(mx-rx)*.12;ry+=(my-ry)*.12;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(loop);})();
window.addEventListener('scroll', () => {
  const nav = document.getElementById('nav');
  if (window.scrollY > 50) nav.classList.add('scrolled');
  else nav.classList.remove('scrolled');
});
</script>
</body>
</html>
